        "issues": {
            "mismatched_lanes": {
                "title": "Inconsistent Lane Tags",
                "tip": "Find roads where lane counts or per-lane tags (turn, change, width) do not agree.",
                "missing_directional": {
                    "message": "{feature} has more than two lanes but is missing lanes:forward or lanes:backward.",
                    "reference": "On two-way roads with more than two lanes, tag lanes:forward and lanes:backward (and lanes:both_ways when centre lanes allow both directions)."
                },
                "total_mismatch": {
                    "message": "{feature} has a lane total that does not match lanes:forward, lanes:backward, and lanes:both_ways.",
                    "reference": "lanes should equal lanes:forward + lanes:backward + lanes:both_ways (omit both_ways when unused)."
                },
                "lane_tag_count": {
                    "message": "{feature}: “{tag}” describes {actual} lanes but {countTag} is {count}.",
                    "reference": "Per-lane tags (turn:lanes*, change:lanes*, width:lanes*) use one `|`-separated value per lane counted in the matching lanes* tag."
                }
            },
            "quebec_motorway_minspeed": {
                "title": "Minimum Speed Missing on a 100 km/h Motorway",
                "tip": "Find one-way Québec motorways posted at 100 km/h without minspeed=60.",
                "message": "{feature} is a one-way motorway in Québec at 100 km/h without minspeed=60.",
                "reference": "In Québec, a one-way motorway with maxspeed=100 is also tagged minspeed=60. Ramps (motorway_link) are not included.",
                "fix": "Set minspeed to 60",
                "annotation": "Added minspeed=60"
            },
            "missing_cycleway_sides": {
                "title": "Missing Cycleway Sides",
                "tip": "Find roads with no cycleway:both and without both cycleway:left and cycleway:right.",
                "message": "{feature} has no cycleway:both, and is missing cycleway:left or cycleway:right.",
                "reference": "A plain cycleway tag is not enough. Tag cycleway:both, or both cycleway:left and cycleway:right.",
                "repeated": {
                    "message": "{feature} repeats \"{value}\" on cycleway and on {sides}.",
                    "reference": "Do not copy a cycleway value onto cycleway:both, cycleway:left, or cycleway:right. Keep it on the side tags only."
                },
                "with_both": {
                    "message": "{feature} has both cycleway and cycleway:both.",
                    "reference": "Use cycleway:both or the plain cycleway tag, not both at once."
                }
            },
            "advisory_maxspeed": {
                "title": "Advisory Speed Without a Legal Speed",
                "tip": "Find features tagged with maxspeed:advisory but no maxspeed.",
                "message": "{feature} has an advisory speed but no maxspeed.",
                "reference": "maxspeed:advisory is a recommended speed. It does not replace the legal maxspeed tag."
            },
            "redundant_directional_tag": {
                "title": "Redundant Plain Tag",
                "tip": "Find features where a plain tag is overridden by its directional variants.",
                "message": "{feature} has a plain \"{tag}\" tag alongside its directional variants",
                "reference": "The plain \"{tag}\" tag is made redundant by its directional variants (\"{tag}:both\", or \"{tag}:left\" and \"{tag}:right\"). The plain tag should be removed to avoid ambiguity."
            }
        }
